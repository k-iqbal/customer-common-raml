#%RAML 1.0 DataType
type: object
displayName: CustomerRequest
description: Payload used to create a customer. customerId, status, and source are server-assigned.
properties:
  firstName:
    type: string
    minLength: 1
    example: "John"
  lastName:
    type: string
    minLength: 1
    example: "Smith"
  email:
    type: string
    pattern: "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
    example: "john.smith@example.com"
  phone:
    type: string
    required: false
    example: "+61 400 000 000"
  company:
    type: string
    required: false
    example: "ABC Company"
